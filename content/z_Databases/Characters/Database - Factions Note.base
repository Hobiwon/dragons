properties:
  file.name:
    displayName: Name
  property.aliases:
    displayName: Aliases
  property.occupation:
    displayName: Occupation
  property.located:
    displayName: Location
  property.organizationTypes:
    displayName: Type
  property.districttype:
    displayName: Type
  property.settlementType:
    displayName: Type
  property.dominion:
    displayName: Dominion
  property.terrain:
    displayName: Terrain
  property.poiTypes:
    displayName: Type
  note.aliases:
    displayName: Aliases
  note.occupation:
    displayName: Occupation
  note.located:
    displayName: Location
  note.organizationTypes:
    displayName: Types
  note.poiTypes:
    displayName: Types
  note.settlementType:
    displayName: Types
  note.dominion:
    displayName: Dominion
  note.terrain:
    displayName: Terrain
  note.poiType:
    displayName: Type
  note.districtType:
    displayName: Type
  note.factionTypes:
    displayName: Types
  note.condition:
    displayName: Condition
  note.factionType:
    displayName: Type
views:
  - type: table
    name: Child Factions
    filters:
      and:
        - file.inFolder("Campaign/Factions")
        - parentFactions.contains(this)
    order:
      - file.name
      - aliases
      - factionType
    columnSize:
      file.name: 272
      note.aliases: 354
  - type: table
    name: Characters
    filters:
      and:
        - file.inFolder("Campaign/Characters")
        - affiliations.contains(this)
    order:
      - file.name
      - aliases
      - occupation
      - located
    columnSize:
      file.name: 262
      note.aliases: 262
      note.occupation: 173
      note.Located: 202
  - type: table
    name: Points of Interest
    filters:
      and:
        - file.inFolder("Campaign/Locations/Points of Interest")
        - affiliations.contains(this)
    order:
      - file.name
      - aliases
      - poiType
      - located
    columnSize:
      file.name: 212
      note.aliases: 193
      note.poiType: 225
      note.located: 272
  - type: table
    name: Settlements
    filters:
      and:
        - file.inFolder("Campaign/Locations/Settlements")
        - affiliations.contains(this)
    order:
      - file.name
      - aliases
      - located
    columnSize:
      file.name: 221
      note.aliases: 234
      note.located: 443
  - type: table
    name: Areas
    filters:
      and:
        - file.inFolder("Campaign/Locations/Areas")
        - affiliations.contains(this)
    order:
      - file.name
      - aliases
      - located
      - dominion
    columnSize:
      file.name: 151
      property.aliases: 189
      property.terrain: 154
      property.located: 168
  - type: table
    name: Regions
    filters:
      and:
        - file.inFolder("Campaign/Locations/Regions")
        - affiliations.contains(this)
    order:
      - file.name
      - aliases
      - located
      - dominion
    columnSize:
      file.name: 151
      property.aliases: 189
      property.terrain: 154
      property.located: 168
  - type: table
    name: Topography
    filters:
      and:
        - file.inFolder("Campaign/Locations/Topography")
        - affiliations.contains(this)
    order:
      - file.name
      - aliases
      - located
      - dominion
    columnSize:
      file.name: 151
      property.aliases: 189
      property.terrain: 154
      property.located: 168
