properties:
  file.name:
    displayName: Name
  note.summary:
    displayName: Summary
views:
  - type: table
    name: Active Quests
    filters:
      and:
        - file.inFolder("Campaign/Parties/Quests")
        - file.hasLink(this)
        - completed != true
    order:
      - file.name
      - summary
    columnSize:
      file.name: 307
