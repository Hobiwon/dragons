properties:
  file.name:
    displayName: Name
  property.aliases:
    displayName: Aliases
  property.occupation:
    displayName: Occupation
  property.located:
    displayName: Location
  property.organizationTypes:
    displayName: Type
  property.districttype:
    displayName: Type
  property.settlementType:
    displayName: Type
  property.dominion:
    displayName: Dominion
  property.terrain:
    displayName: Terrain
  property.poiTypes:
    displayName: Type
  note.aliases:
    displayName: Aliases
  note.occupation:
    displayName: Occupation
  note.located:
    displayName: Location
  note.organizationTypes:
    displayName: Types
  note.poiTypes:
    displayName: Types
  note.settlementType:
    displayName: Types
  note.dominion:
    displayName: Dominion
  note.terrain:
    displayName: Terrain
  note.poiType:
    displayName: Type
  note.tags:
    displayName: Tags
views:
  - type: table
    name: All
    filters:
      and:
        - file.hasLink(this)
    order:
      - file.name
      - aliases
    sort:
      - property: file.folder
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 220
      note.aliases: 255
  - type: table
    name: Characters
    filters:
      and:
        - file.inFolder("Campaign/Characters")
        - file.hasLink(this)
        - or:
            - '!condition.contains("Dead")'
            - condition.isEmpty()
    order:
      - file.name
      - aliases
      - located
    columnSize:
      file.name: 151
      note.aliases: 127
      note.occupation: 137
      note.located: 553
  - type: table
    name: Organizations
    filters:
      and:
        - file.inFolder("Campaign/Organizations")
        - file.hasLink(this)
    order:
      - file.name
      - aliases
      - organizationTypes
    columnSize:
      file.name: 151
      note.aliases: 260
  - type: table
    name: Locations
    filters:
      and:
        - file.inFolder("Campaign/Locations")
        - file.hasLink(this)
        - not:
            - owners.contains(this)
            - dominion.contains(this)
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - aliases
      - located
    columnSize:
      file.name: 249
      note.aliases: 315
  - type: table
    name: Vehicles/Possessions
    filters:
      and:
        - file.inFolder("Campaign/Possessions")
        - file.hasLink(this)
        - not:
            - organizations.contains(this)
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - aliases
      - located
    columnSize:
      file.name: 249
      note.aliases: 315
  - type: table
    name: Session Notes
    filters:
      and:
        - file.inFolder("Campaign/Parties/Session Notes")
        - file.hasLink(this)
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - aliases
      - located
    columnSize:
      file.name: 249
      note.aliases: 315
  - type: table
    name: Lore
    filters:
      and:
        - file.inFolder("Campaign/Lore")
        - file.hasLink(this)
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - aliases
      - located
    columnSize:
      file.name: 249
      note.aliases: 315
  - type: table
    name: Quests & Adventures
    filters:
      and:
        - file.hasLink(this)
        - or:
            - file.inFolder("Campaign/Parties/Quests")
            - file.inFolder("Campaign/Parties/Adventures")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - aliases
      - located
    columnSize:
      file.name: 249
      note.aliases: 315
  - type: table
    name: Service Requests
    filters:
      and:
        - file.inFolder("Campaign/Parties/Service Requests")
        - file.hasLink(this)
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - aliases
      - located
    columnSize:
      file.name: 249
      note.aliases: 315
